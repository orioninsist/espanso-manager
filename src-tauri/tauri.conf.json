{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Espanso Manager",
  "version": "0.1.0",
  "identifier": "io.github.orioninsist.espanso-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Espanso Manager",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
